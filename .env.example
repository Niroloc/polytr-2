# Copy to `.env` and edit before `docker compose up`.

# ---- Bot ----
# Paper-trading mode. ONLY set to false after a live exec.VenueClient is wired.
PAPER=true

# Strike + signal config
STRIKE_STEP=100
STRIKE_MINUTES=5
ENTRY_EDGE=0.03
EXIT_EDGE=0.005
MIN_SECONDS=5
TICK_SIZE=0.01
ORDER_SIZE=100

# ---- Replay ----
# RFC3339 range. Leave empty → last 24h.
REPLAY_FROM=
REPLAY_TO=
REPLAY_STRIDE=50
REPLAY_PORT=8080

# ---- Host log directory ----
# Bind-mounted into /logs inside both containers. Defaults to ./logs next to
# the compose file. The container writes bot.log and replay.log here.
# Container runs as root, so files appear root-owned on the host (use `sudo`
# to clean up). No chown setup needed on first run.
HOST_LOGS_DIR=./logs
