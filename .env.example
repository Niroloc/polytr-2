# Copy to `.env` and edit before `docker compose up`.

# ---- Bot ----
# Paper-trading mode. ONLY set to false after a live exec.VenueClient is wired.
PAPER=true

# Tick log retention. Set to "0" or "-1s" to disable the janitor and keep
# all collected history (useful for long-horizon backtests; watch disk).
# Default: 168h = 7d.
RETENTION=168h

# Strike + signal config
STRIKE_MINUTES=5
ENTRY_EDGE=0.03
EXIT_EDGE=0.005
MIN_SECONDS=5
TICK_SIZE=0.01
ORDER_SIZE=100

# ---- Replay ----
# RFC3339 range. Leave empty → from = 24h ago, to = now.
REPLAY_FROM=
REPLAY_TO=
# Live tail: when true, /api/samples?since= polls the engine for new ticks
# every 2s and the chart appends them in real time. Set false for a static
# historical snapshot view.
REPLAY_LIVE=true
REPLAY_STRIDE=50
REPLAY_PORT=8080

# ---- Host log directory ----
# Bind-mounted into /logs inside both containers. Defaults to ./logs next to
# the compose file. The container writes bot.log and replay.log here.
# Container runs as root, so files appear root-owned on the host (use `sudo`
# to clean up). No chown setup needed on first run.
HOST_LOGS_DIR=./logs
